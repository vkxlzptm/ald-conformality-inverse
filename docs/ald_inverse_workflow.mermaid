flowchart TB
    subgraph GEN["① Training-data generation &nbsp;·&nbsp; offline, once &nbsp;·&nbsp; 6 h on 6 cores"]
    direction LR
        P["<b>Sample parameter prior</b><br/>s₀ at T_ref · activation energy Ea<br/>steric exponent n · re-emission survival · site density"]
        C["<b>Sample process conditions</b><br/>AR 10–50 · dose-per-site Π₂ 0.8–30"]
        SIM["<b>Feature-scale ballistic MC simulator</b><br/>3D axisymmetric cylinder · free-molecular transport<br/>diffuse re-emission + self-limiting surface reaction<br/><i>written from scratch — not kMC, and not called kMC</i>"]
        Y["<b>Depth profiles θ(z)</b><br/>3 temperatures × 64 depth bins<br/><i>one MC run snapshotted at 6 dose levels</i>"]
        DS[("<b>Dataset · 108,000 examples</b><br/>600 shards, resumable<br/>input (y, c) → target p")]
        P --> SIM
        C --> SIM
        SIM --> Y --> DS
    end

    subgraph LEARN["② Training &nbsp;·&nbsp; offline, once &nbsp;·&nbsp; ~35 min"]
    direction LR
        OBS["<b>Measurement model, applied every epoch</b><br/>noise topped up to ±3 % · 10 of 64 depth bins masked<br/><i>doubles as augmentation</i>"]
        EMB["<b>Physics built into the architecture</b><br/>net outputs (s₀_ref, Ea) — s(T) is the analytic Arrhenius form<br/>known conditions are log AR and log <b>absolute dose</b><br/><i>Π₂ must NOT be an input: its denominator is the unknown site density</i>"]
        NET["<b>1D CNN over the 3×64 profile + conditions</b><br/>→ mixture-density head<br/>→ posterior over 5 parameters"]
        OBS --> EMB --> NET
    end

    subgraph USE["③ Inference &nbsp;·&nbsp; online &nbsp;·&nbsp; milliseconds"]
    direction LR
        MEAS["<b>One measured profile set</b><br/>TEM cross-sections at 3 temperatures"]
        INF["<b>Single forward pass</b>"]
        EST["<b>Posterior over parameters</b><br/>s₀ · Ea · n · re-emission · site density<br/><i>width reveals what the data cannot pin down</i>"]
        PRED["<b>Dose required at a different AR</b><br/>observe AR 20 → prescribe for AR 50"]
        MEAS --> INF --> EST --> PRED
    end

    subgraph OLD["Conventional route &nbsp;·&nbsp; repeated per measurement"]
    direction LR
        LSQ["<b>Derivative-free least squares</b><br/>Nelder-Mead · multi-start · common random numbers<br/>~800 simulator calls · ~10 min per measurement"]
        EST2["<b>Point estimate only</b><br/>no uncertainty, and the residual reaches the noise floor<br/>while parameters stay far from truth"]
        LSQ --> EST2
    end

    VAL["<b>④ Validation</b><br/>1. Zero-reaction transmission vs a deterministic solution of the Clausing<br/>&nbsp;&nbsp;&nbsp;&nbsp;integral equation — agrees to ≤ 0.25 % &nbsp;<b>PASSED</b><br/>2. Head-to-head with the least-squares baseline — accuracy, calibration, wall clock<br/>3. AR transfer — observe AR 20, predict the dose needed at AR 50<br/>4. Model misspecification — mechanisms outside the training prior &nbsp;<i>if time allows</i>"]

    SPLIT["<b>Split by shard, never by example</b><br/>the 6 dose snapshots of one draw share identical ground truth"]

    DS ==> SPLIT ==> LEARN
    LEARN ==trained==> USE
    USE -.replaces.-> OLD
    USE --> VAL
    OLD --> VAL

    style SIM fill:#14505f,color:#ffffff,stroke:#0b3038
    style NET fill:#6b3a12,color:#ffffff,stroke:#3d2009
    style EMB fill:#1f4d2a,color:#ffffff,stroke:#0f2a16
    style DS fill:#2b2b2b,color:#ffffff,stroke:#000000
    style SPLIT fill:#fff4e0,stroke:#b9770e
    style OLD fill:#f5e2e2,stroke:#a33
    style VAL fill:#eef2ff,stroke:#556
